FROM alpine:3.24.3

ENV TZ=UTC \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Install runtime dependencies and development tools
RUN apk add --no-cache python3 py3-pip tzdata py3-paramiko openssh-client

COPY requirements.txt /app/
COPY src/ /app/

# Install application and development dependencies
RUN export PIP_BREAK_SYSTEM_PACKAGES=1 && \
    pip3 install --no-cache-dir -Ur /app/requirements.txt && \
    pip3 install --no-cache-dir debugpy watchdog[watchmedo] && \
    chmod +x /app/dcb_mute.py && ln -s /app/dcb_mute.py /usr/local/bin/dcb-mute

# A remote ssh:// host whose link dies has to fail, not hang. The bot puts
# its own timeout on every read from the ssh pipe; these end the connection
# when the link itself is gone, which no read timeout can tell apart.
# Written as the system defaults, so a ~/.ssh/config mapped in still wins.
RUN mkdir -p /etc/ssh/ssh_config.d && \
    printf 'Host *\n    BatchMode yes\n    ConnectTimeout 10\n    ServerAliveInterval 10\n    ServerAliveCountMax 3\n' \
        > /etc/ssh/ssh_config.d/docker-controller-bot.conf

# Health check
# Healthy while the bot keeps taking work: a heartbeat the bot writes through
# the same workers that answer the buttons, so with every one of them stuck
# it stops. The old check only proved that python3 was installed.
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python3 -c "import os, sys, time; sys.exit(0 if time.time() - os.path.getmtime('/tmp/dcb-heartbeat') < 120 else 1)" || exit 1

# Use watchdog for file monitoring instead of nodemon. The locale directory is
# watched too because i18n caches each file on first read, so a translation
# edited while running would otherwise keep falling back to English until the
# next restart. Neither directory is watched recursively: /app/config and
# /app/schedule hold the state the bot itself writes, and restarting on those
# would loop.
ENTRYPOINT ["watchmedo", "auto-restart", "-d", "/app", "-d", "/app/locale", "-p", "*.py;*.json", "--", "python3", "docker-controller-bot.py"]
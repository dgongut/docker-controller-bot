FROM alpine:3.24.1

ENV TZ=UTC

WORKDIR /app

# Install runtime dependencies and debugger
RUN apk add --no-cache python3 py3-pip tzdata py3-paramiko openssh-client && \
    export PIP_BREAK_SYSTEM_PACKAGES=1 && \
    pip3 install --no-cache-dir debugpy

COPY requirements.txt docker-controller-bot.py core.py commands.py callbacks.py config.py store.py migration.py callback_registry.py host_registry.py i18n.py docker_update.py docker_compose_manager.py compose_generator.py schedule_flow.py schedule_manager.py port_manager.py logger.py message_queue.py /app/
COPY locale /app/locale

# Install application dependencies
RUN export PIP_BREAK_SYSTEM_PACKAGES=1 && \
    pip3 install --no-cache-dir -Ur /app/requirements.txt

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python3 -c "import sys; sys.exit(0)" || exit 1

CMD ["python3", "docker-controller-bot.py"]